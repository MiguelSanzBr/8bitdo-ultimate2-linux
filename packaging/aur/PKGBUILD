# Maintainer: Miguel Sanz <123277580+MiguelSanzBr@users.noreply.github.com>
pkgname=8bitdo-ultimate2
_tag=0.1.0-beta.7
pkgver=0.1.0beta7
pkgrel=1
pkgdesc="Open-source Linux configurator for the 8BitDo Ultimate 2 Wireless controller (CLI + GUI)"
arch=('any')
url="https://github.com/MiguelSanzBr/8bitdo-ultimate2-linux"
license=('MIT')
depends=('python' 'tk' 'hicolor-icon-theme')   # tk: the GUI (tkinter)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
install=8bitdo-ultimate2.install
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('29aa79c5e6b152516eb1e8ceca7c2b3d1050a9235b0ae4d0a11e387409d04b61')

build() {
  cd "8bitdo-ultimate2-linux-$_tag"
  python -m build --wheel --no-isolation
}

package() {
  cd "8bitdo-ultimate2-linux-$_tag"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 udev/70-8bitdo-u2.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 packaging/u2gui.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/ultimate2.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
